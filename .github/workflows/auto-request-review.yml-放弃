name: Auto Request Review

on:
  pull_request_target:
    types: [synchronize]

permissions:
  pull-requests: write
  contents: read

jobs:
  request-review:
    runs-on: ubuntu-latest
    if: github.actor != 'su600'
    
    steps:
      - name: Request review from su600
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          # 直接获取当前运行的仓库名，例如 "su600/my-repo"
          REPO: ${{ github.repository }}
        run: |
          echo "检测到非 su600 提交，正在处理仓库 $REPO 的 PR #$PR_NUMBER ..."
          
          # 通过 --repo 参数显式指定仓库，不再依赖本地 .git 目录
          gh pr edit "$PR_NUMBER" --repo "$REPO" --add-reviewer su600
          
          echo "Done!"
